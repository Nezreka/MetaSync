# MetaSync node — copy to .env or pass via compose. Nothing here is a secret
# the repo provides; every key is yours.
METASYNC_STATE_DIR=/data
METASYNC_PORT=8790

# Step A bootstrap (or use the UI): your SoulSync + a key from
# SoulSync Settings -> API keys.
SOULSYNC_URL=http://soulsync:8000
SOULSYNC_API_KEY=sk_...

# Step B bootstrap (optional): seed the SIN pool as a normal node.
# Joining a pool can also be done later from the Pools page in the UI.
SIN_URL=
SIN_INGEST_KEY=

# First runs are previews. Set to false only after you have seen the
# payload on the preview page and are happy with it.
METASYNC_DRY_RUN=true
