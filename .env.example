# Copy the real values into .env (if it exists) or .env.local — the file
# `neon env pull` writes and `neon deploy --env <file>` reads.
# NEVER commit a real value. No real secrets exist in this repo.

# Injected by Neon at runtime / by `neon env pull` locally — listed here
# only so you know the names the code reads:
# DATABASE_URL=postgres://...-pooler.../neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://.../neondb?sslmode=require

# Shared secret the SIN sidecar sends as the X-SIN-Key header on
# POST /v1/report and POST /v1/aggregate. Generate a long random value:
#   openssl rand -hex 32
SIN_INGEST_KEY=replace-with-a-long-random-value
