# MetaSync portal — environment.
# Copy to .env for local dev; in production these live in the Vercel
# project env. See README.md for Boulder's go-live checklist.

# Pooled Neon connection string for the SHARED MetaSync database
# (same database the SIN backend uses, project fragrant-mouse-42130917).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth secret: `openssl rand -base64 32`
AUTH_SECRET=""

# Google sign-in (primary — Boulder's decision, same setup as roll-call).
# Register the OAuth app in Google Cloud Console with redirect URI:
#   https://metasync.ssync.net/api/auth/callback/google
# (local dev: also add http://localhost:3001/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub sign-in (also enabled, like roll-call).
# OAuth app callback URL: https://metasync.ssync.net/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Pepper for key hashing (SHA-256 of pepper + raw key). Generate ONCE:
#   openssl rand -hex 32
# The SAME value must later be set in the SIN function env, or every
# portal key fails verification there. Production fails fast without it.
API_KEY_PEPPER=""

# Comma-separated emails promoted to role="admin" on first sign-in
# (roll-call's bootstrap). Boulder's email goes here.
ADMIN_EMAILS=""

# The pool URL shown on the dashboard with a copy button. Raw Neon
# function URL until the pool.ssync.net Worker exists (PORTAL-DESIGN §7.4).
POOL_URL=""
