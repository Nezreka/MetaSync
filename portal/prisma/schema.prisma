// MetaSync portal — Prisma schema (CLIENT MIRROR ONLY).
//
// Source of truth for the database shape is the MetaSync repo's SQL
// migration sequence: db/migrations/0003_portal_auth.sql creates these
// tables in the SAME Neon database the SIN backend uses
// (project fragrant-mouse-42130917). This schema contains ONLY the
// portal models — never point Prisma at this database with a schema
// that claims the SIN tables (raw_reports, aggregates, ...).
//
// Model/column names follow PORTAL-DESIGN.md §2 exactly: Prisma models
// are Portal*, tables map to portal_* (snake_case), columns map to
// snake_case so the schema and the SQL migration agree name-for-name.
// Mirrors roll-call's User/Account/Session/VerificationToken/ApiKey
// core with billing/tiers/usage removed (see PORTAL-DESIGN.md §2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PortalUser {
  id            String    @id @default(cuid())
  email         String    @unique // stored lowercased by the app
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  role          String    @default("user") // "user" | "admin"
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts PortalAccount[]
  sessions PortalSession[]
  keys     PortalKey[]

  @@map("portal_users")
}

model PortalAccount {
  // OAuth linking (Auth.js Prisma adapter shape)
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("portal_accounts")
}

model PortalSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("portal_sessions")
}

model PortalVerificationToken {
  // Only used by the magic-link option (PORTAL-DESIGN.md §5) — ships now
  // so the sign-in decision stays reversible without a second migration.
  identifier String // email
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("portal_verification_tokens")
}

model PortalKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  label      String // user-chosen: "NAS", "living-room PC"
  keyHash    String    @unique @map("key_hash") // SHA-256(pepper + rawKey), hex
  keyPrefix  String    @map("key_prefix") // first 12 chars of the raw key
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at") // null at launch; field ships for later
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  revokedAt  DateTime? @map("revoked_at")

  // Validity: revokedAt IS NULL AND (expiresAt IS NULL OR expiresAt > now()).
  // There is intentionally no status/isActive boolean — a single nullable
  // timestamp cannot contradict itself (roll-call's rule, copied).

  // Node binding (PORTAL-DESIGN.md §3A.3) — mirrors
  // db/migrations/0004_metasync_node_bindings.sql name-for-name. One key
  // binds to exactly ONE approved MetaSync node: the pool's exchange
  // issues passes only to the bound node's signing key. A node asks to
  // bind by presenting its public key at exchange time; the pool parks
  // it in the pending_* fields and issues NOTHING until the account
  // holder approves here in the portal (fingerprint comparison).
  boundNodeId          String?   @map("bound_node_id") // SHA-256(public key), hex
  boundNodePublicKey   String?   @map("bound_node_public_key") // Ed25519 public key, base64url
  boundAt              DateTime? @map("bound_at")
  pendingNodeId        String?   @map("pending_node_id")
  pendingNodePublicKey String?   @map("pending_node_public_key")
  pendingRequestedAt   DateTime? @map("pending_requested_at")

  // The partial unique index on bound_node_public_key (non-null bindings
  // on unrevoked keys) CANNOT be expressed in the Prisma schema — it is
  // migration-owned, carried by the SQL in 0004. Do not "fix" a drift
  // report by removing it here or in the migration.

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([boundNodeId])
  @@map("portal_keys")
}
